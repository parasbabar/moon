# ============================================================
# Midnight Verify — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ---- Network ----

# Midnight network to target: "preprod" | "preview" | "standalone"
VITE_MIDNIGHT_NETWORK=preprod

# Indexer GraphQL endpoint (HTTP)
VITE_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql

# Indexer GraphQL WebSocket endpoint
VITE_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws

# Proof server URL (required for ZK proof generation)
# For local development: http://localhost:6300
# For preprod: use the Midnight-provided proof server
VITE_PROOF_SERVER_URL=http://localhost:6300

# ---- Contract ----

# Deployed AgeVerify contract address on Midnight Preprod.
# Set to the address below to verify against the already-deployed contract.
# Leave empty to deploy a new contract on first run.
VITE_CONTRACT_ADDRESS=b23f1a6e52f5e3c02127bfb5b47e20db95ba033a708479fb55057875bf133c3e

# Eligibility threshold (default: 18)
VITE_ELIGIBILITY_THRESHOLD=18

# Midnight Preprod block explorer base URL (used for transaction links).
# Override to point at a different explorer or network if needed.
VITE_EXPLORER_URL=https://explorer.preprod.midnight.network

# ---- Deployment (Server-side only) ----

# Wallet seed for deployment (64-char hex or 24-word mnemonic)
# NEVER commit this value or share it publicly
# MIDNIGHT_DEPLOY_SEED=

# ---- Development ----

# Enable verbose logging in development
VITE_DEBUG=false

# ============================================================
# SECURITY NOTES
# ============================================================
# - Never commit private keys, seed phrases, or wallet credentials
# - VITE_ prefix makes variables available in the frontend bundle
#   (they will be visible in the browser — do not put secrets here)
# - Wallet private keys are managed entirely by the Lace wallet
#   extension — this application never handles private keys
# ============================================================
